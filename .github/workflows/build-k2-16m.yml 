name: Build X-WRT K2 16MB

on:
  workflow_dispatch:
    inputs:
      branch:
        description: 'X-WRT branch to build'
        required: true
        default: 'master'

env:
  TZ: Asia/Shanghai

jobs:
  build:
    runs-on: ubuntu-22.04

    steps:
    - name: Checkout
      uses: actions/checkout@v4

    - name: Free Disk Space
      run: |
        sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc
        sudo docker image prune -a -f
        sudo swapoff -a
        sudo rm -f /swapfile

    - name: Install Dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential ecj fastjar file flex g++ \
          gcc-multilib g++-multilib gawk gettext git git-core \
          libelf-dev libncurses5-dev libncursesw5-dev libssl-dev \
          swig python3 python3-dev python3-distutils python3-pyelftools \
          subversion unzip wget zlib1g-dev rsync qemu-utils \
          libboost-dev libpam0g-dev xsltproc liblzma-dev

    - name: Clone X-WRT Source
      run: |
        git clone --depth 1 --branch ${{ github.event.inputs.branch }} \
          https://github.com/x-wrt/x-wrt.git xwrt
        cd xwrt
        echo "XWRT_VERSION=$(cat include/version.mk | grep VERSION_NUMBER | awk -F'=' '{print $2}' | tr -d ' ')" >> $GITHUB_ENV

    - name: Copy Custom DTS and Device Profile
      run: |
        # 复制修改后的16MB DTS文件
        cp target/linux/ramips/dts/mt7620a_phicomm_k2-16m.dts \
           xwrt/target/linux/ramips/dts/mt7620a_phicomm_k2-16m.dts

        # 在mt7620.mk末尾追加16MB设备定义
        cat >> xwrt/target/linux/ramips/image/mt7620.mk << 'EOF'

        define Device/phicomm_k2-16m
          $(Device/phicomm_k2)
          DEVICE_MODEL := K2 (16MB Flash)
          DEVICE_DTS := mt7620a_phicomm_k2-16m
          IMAGE_SIZE := 15872k
        endef
        TARGET_DEVICES += phicomm_k2-16m
        EOF

    - name: Update Feeds
      run: |
        cd xwrt
        ./scripts/feeds update -a
        ./scripts/feeds install -a

    - name: Generate .config
      run: |
        cd xwrt
        cat > .config << 'CONFIGEOF'
        CONFIG_TARGET_ramips=y
        CONFIG_TARGET_ramips_mt7620=y
        CONFIG_TARGET_ramips_mt7620_DEVICE_phicomm_k2-16m=y

        # 基础系统与 LuCI 界面
        CONFIG_PACKAGE_luci=y
        CONFIG_PACKAGE_luci-base=y
        CONFIG_PACKAGE_luci-mod-admin-full=y
        CONFIG_PACKAGE_luci-theme-bootstrap=y
        CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
        CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
        CONFIG_PACKAGE_luci-i18n-network-zh-cn=y
        CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
        CONFIG_PACKAGE_luci-i18n-system-zh-cn=y
        CONFIG_PACKAGE_luci-i18n-wifi-zh-cn=y
        CONFIG_PACKAGE_luci-compat=y
        CONFIG_PACKAGE_luci-lib-base=y
        CONFIG_PACKAGE_luci-lib-ipkg=y
        CONFIG_PACKAGE_luci-proto-ppp=y

        # 核心网络组件
        CONFIG_PACKAGE_ppp=y
        CONFIG_PACKAGE_ppp-mod-pppoe=y
        CONFIG_PACKAGE_dnsmasq-full=y
        CONFIG_PACKAGE_ip-full=y
        CONFIG_PACKAGE_iptables=y
        CONFIG_PACKAGE_iptables-mod-fullconenat=y
        CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
        CONFIG_PACKAGE_iptables-mod-extra=y
        CONFIG_PACKAGE_iptables-mod-ipopt=y
        CONFIG_PACKAGE_firewall=y
        CONFIG_PACKAGE_ipv6helper=y
        CONFIG_PACKAGE_ip6tables=y
        CONFIG_PACKAGE_ip6tables-extra=y
        CONFIG_PACKAGE_ip6tables-mod-nat=y

        # 无线驱动 (MT7620A + MT7612EN)
        CONFIG_PACKAGE_kmod-mt7603=y
        CONFIG_PACKAGE_kmod-mt76x2=y
        CONFIG_PACKAGE_kmod-mt76x2-common=y
        CONFIG_PACKAGE_kmod-mac80211=y
        CONFIG_PACKAGE_kmod-cfg80211=y
        CONFIG_PACKAGE_wpad-openssl=y
        CONFIG_PACKAGE_hostapd-common=y
        CONFIG_PACKAGE_iw=y
        CONFIG_PACKAGE_iwinfo=y

        # USB 支持
        CONFIG_PACKAGE_kmod-usb2=y
        CONFIG_PACKAGE_kmod-usb-ohci=y
        CONFIG_PACKAGE_kmod-usb-core=y
        CONFIG_PACKAGE_kmod-usb-storage=y
        CONFIG_PACKAGE_kmod-usb-storage-extras=y
        CONFIG_PACKAGE_kmod-usb-storage-uas=y
        CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
        CONFIG_PACKAGE_block-mount=y
        CONFIG_PACKAGE_blockd=y
        CONFIG_PACKAGE_fdisk=y
        CONFIG_PACKAGE_e2fsprogs=y
        CONFIG_PACKAGE_mkf2fs=y

        # 常用系统工具
        CONFIG_PACKAGE_opkg=y
        CONFIG_PACKAGE_htop=y
        CONFIG_PACKAGE_curl=y
        CONFIG_PACKAGE_wget-ssl=y
        CONFIG_PACKAGE_coreutils=y
        CONFIG_PACKAGE_coreutils-nohup=y
        CONFIG_PACKAGE_tar=y
        CONFIG_PACKAGE_unzip=y
        CONFIG_PACKAGE_resolveip=y
        CONFIG_PACKAGE_kmod-tun=y
        CONFIG_PACKAGE_ipset=y
        CONFIG_PACKAGE_autocore=y
        CONFIG_PACKAGE_default-settings=y

        # 编译优化与自定义标识
        CONFIG_DEVEL=y
        CONFIG_CCACHE=y
        CONFIG_TARGET_ROOTFS_SQUASHFS=y
        CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
        CONFIG_TARGET_SQUASHFS_COMP_XZ=y
        CONFIG_KERNEL_BUILD_USER="X-WRT"
        CONFIG_KERNEL_BUILD_DOMAIN="X-WRT"
        CONFIG_KERNEL_LOCALVERSION="-k2-16m-v22.4"
        CONFIGEOF

    - name: Download Packages
      run: |
        cd xwrt
        make defconfig
        make download -j$(nproc) || make download -j1 V=s

    - name: Compile Firmware
      run: |
        cd xwrt
        make -j$(nproc) || make -j1 V=s

    - name: Upload Artifacts
      uses: actions/upload-artifact@v4
      with:
        name: X-WRT-K2-16M-v22.4
        path: xwrt/bin/targets/ramips/mt7620/*.bin
